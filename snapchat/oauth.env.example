# Snapchat OAuth — hemmeligheter skal IKKE i Git eller frontend.
#
# Legg inn i Supabase: Project Settings → Edge Functions → Secrets (anbefalt):
#   SNAP_CLIENT_SECRET = (Key fra Snapchat OAuth App)
#   SNAP_CLIENT_ID     = (Client ID — kan også settes her hvis du vil overstyre)
#   SNAP_REDIRECT_URI  = https://mj-universe.net/snapchat/oauth-callback.html
#
# CLI: supabase secrets set --project-ref <ref> SNAP_CLIENT_SECRET="..." osv.
#
# Lokalt (kun utvikling, ikke commit). Bruk ekte verdier fra Snapchat — ikke lim eksempeltekst inn i Supabase.
SNAP_CLIENT_ID=REPLACE_WITH_YOUR_SNAP_OAUTH_CLIENT_UUID
SNAP_CLIENT_SECRET=REPLACE_WITH_YOUR_SNAP_OAUTH_CLIENT_SECRET
SNAP_REDIRECT_URI=https://mj-universe.net/snapchat/oauth-callback.html
